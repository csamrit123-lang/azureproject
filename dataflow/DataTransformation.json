{
	"name": "DataTransformation",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ls_DelimitedText",
						"type": "DatasetReference"
					},
					"name": "DimAirline"
				},
				{
					"dataset": {
						"referenceName": "ls_DelimitedText",
						"type": "DatasetReference"
					},
					"name": "Dimflight"
				},
				{
					"dataset": {
						"referenceName": "ls_DelimitedText",
						"type": "DatasetReference"
					},
					"name": "DimPassenger"
				},
				{
					"dataset": {
						"referenceName": "ls_DelimitedText",
						"type": "DatasetReference"
					},
					"name": "FackBooking"
				},
				{
					"dataset": {
						"referenceName": "ds_api_sink",
						"type": "DatasetReference"
					},
					"name": "DimAirport"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumnCountry"
				},
				{
					"name": "DepartureTimestamp"
				},
				{
					"name": "GenderFlag"
				},
				{
					"name": "ReplaceForGendefFlag"
				},
				{
					"name": "Agefilter"
				},
				{
					"name": "FirstNameTransformation"
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          airline_id as short,",
				"          airline_name as string,",
				"          country as string",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> DimAirline",
				"source(output(",
				"          flight_id as short,",
				"          flight_number as string,",
				"          departure_time as string,",
				"          arrival_time as string",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> Dimflight",
				"source(output(",
				"          passenger_id as short,",
				"          full_name as string,",
				"          gender as string,",
				"          age as short,",
				"          country as string",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> DimPassenger",
				"source(output(",
				"          booking_id as short,",
				"          passenger_id as short,",
				"          flight_id as short,",
				"          airline_id as short,",
				"          origin_airport_id as short,",
				"          destination_airport_id as short,",
				"          booking_date as string,",
				"          ticket_cost as double,",
				"          flight_duration_mins as short,",
				"          checkin_status as boolean",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> FackBooking",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'documentPerLine') ~> DimAirport",
				"DimAirline derive(country = upper(country)) ~> derivedColumnCountry",
				"Dimflight select(mapColumn(",
				"          flight_id,",
				"          flight_number,",
				"          departure_timestamp = departure_time,",
				"          arrival_time",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> DepartureTimestamp",
				"DimPassenger select(mapColumn(",
				"          passenger_id,",
				"          full_name,",
				"          genderFlag = gender,",
				"          age,",
				"          country",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> GenderFlag",
				"GenderFlag derive(genderFlag = replace(replace(genderFlag,'M','Male'),'F','Female')) ~> ReplaceForGendefFlag",
				"ReplaceForGendefFlag filter(age>=25) ~> Agefilter",
				"Agefilter derive(firstName = split(full_name,\" \")[1]) ~> FirstNameTransformation",
				"FirstNameTransformation derive(LastName = split(full_name,\" \")[2]) ~> derivedColumn1"
			]
		}
	}
}