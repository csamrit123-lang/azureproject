{
	"name": "SQLToDataLake_pipeline",
	"properties": {
		"activities": [
			{
				"name": "Set variable to check the currebt time",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_now",
					"value": {
						"value": "@utcNow()",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Lookup for retrive the value from lastloadfile",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "Json_dynamic_dataset",
						"type": "DatasetReference",
						"parameters": {
							"container": "monitor",
							"folder": "lastload",
							"file": "lastload"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "If Condition to remove the empty file",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Copy data for sql to blob",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(activity('Copy data for sql to blob').output.rowsCopied,0)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Delete1",
							"type": "Delete",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "ls_DelimitedText",
									"type": "DatasetReference",
									"parameters": {
										"folder": "sqlload",
										"filename": {
											"value": "@variables('file_nme')",
											"type": "Expression"
										}
									}
								},
								"logStorageSettings": {
									"linkedServiceName": {
										"referenceName": "Azure_DataLake_lnk",
										"type": "LinkedServiceReference"
									},
									"path": "archive"
								},
								"enableLogging": true,
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								}
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Copy data for update the lastload file",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "Script activity to get the max",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "JsonSource",
									"additionalColumns": [
										{
											"name": "lastload",
											"value": {
												"value": "@activity('Script activity to get the max').output.resultSets[0].rows[0].max_date",
												"type": "Expression"
											}
										}
									],
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "JsonReadSettings"
									}
								},
								"sink": {
									"type": "JsonSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "JsonWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "Json_dynamic_dataset",
									"type": "DatasetReference",
									"parameters": {
										"container": "monitor",
										"folder": "emptyjson",
										"file": "empty.json"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "Json_dynamic_dataset",
									"type": "DatasetReference",
									"parameters": {
										"container": "monitor",
										"folder": "lastload",
										"file": "lastload"
									}
								}
							]
						},
						{
							"name": "Script activity to get the max",
							"type": "Script",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "Azure_Sql_link",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "\nselect max(booking_date) as max_date from dbo.FactBookings",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			},
			{
				"name": "Copy data for sql to blob",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Lookup for retrive the value from lastloadfile",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set variable to check the currebt time",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select * from dbo.FactBookings where booking_date>'@{activity('Lookup for retrive the value from lastloadfile').output.value[0].lastload}' and booking_date<='@{variables('v_now')}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "Azure_Sql_dataset",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ls_DelimitedText",
						"type": "DatasetReference",
						"parameters": {
							"folder": "sqlload",
							"filename": {
								"value": "@variables('file_nme')",
								"type": "Expression"
							}
						}
					}
				]
			}
		],
		"variables": {
			"v_now": {
				"type": "String"
			},
			"file_nme": {
				"type": "String",
				"defaultValue": "@concat('flight.csv','_',utcNow())"
			}
		},
		"annotations": []
	}
}