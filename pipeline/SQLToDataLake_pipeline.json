{
	"name": "SQLToDataLake_pipeline",
	"properties": {
		"activities": [
			{
				"name": "Copy data for sql to blob",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Set variable to check the currebt time",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Lookup for retrive the value from lastloadfile",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select * from dbo.FactBookings where booking_date>'@{activity('Lookup for retrive the value from lastloadfile').output.value[0].lastload}' and booking_date<='@{variables('v_now')}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "Azure_Sql_dataset",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ls_DelimitedText",
						"type": "DatasetReference",
						"parameters": {
							"folder": "sqlload",
							"filename": {
								"value": "@concat('flight.csv','_',utcNow())",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Set variable to check the currebt time",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_now",
					"value": {
						"value": "@utcNow()",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Lookup for retrive the value from lastloadfile",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "Json_dynamic_dataset",
						"type": "DatasetReference",
						"parameters": {
							"container": "monitor",
							"folder": "lastload",
							"file": "lastload"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Copy data for update the lastload file",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Script activity to get the max",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"additionalColumns": [
							{
								"name": "lastload",
								"value": {
									"value": "@activity('Script activity to get the max').output.max_date",
									"type": "Expression"
								}
							}
						],
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "JsonWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "Json_dynamic_dataset",
						"type": "DatasetReference",
						"parameters": {
							"container": "monitor",
							"folder": "emptyjson",
							"file": "empty.json"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "Json_dynamic_dataset",
						"type": "DatasetReference",
						"parameters": {
							"container": "monitor",
							"folder": "lastload",
							"file": "lastload"
						}
					}
				]
			},
			{
				"name": "Script activity to get the max",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Copy data for sql to blob",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "Azure_Sql_link",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "\nselect max(booking_date) as max_date from dbo.FactBookings",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
		"variables": {
			"v_now": {
				"type": "String"
			}
		},
		"annotations": []
	}
}